# ---------- Servidor ----------
PORT=80
SESSION_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria

# ---------- Base de datos (Amazon RDS MySQL) ----------
DB_HOST=TU-ENDPOINT-RDS.rds.amazonaws.com
DB_PORT=3306
DB_NAME=cloudprofiles
DB_USER=admin
DB_PASS=TU_PASSWORD_RDS

# ---------- Amazon S3 ----------
# No pongas Access Key / Secret Key aqui: EC2 usa el IAM Role asignado
# a la instancia y el SDK las toma automaticamente.
S3_BUCKET=cloudprofiles-imagenes
S3_REGION=us-east-1

# ---------- Cuenta admin inicial (usada solo por setup_admin.js) ----------
ADMIN_EMAIL=admin@cloudprofiles.com
ADMIN_PASSWORD=Admin123
