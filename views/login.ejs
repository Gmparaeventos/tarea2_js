<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Iniciar sesion - CloudProfiles</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="navbar">
        <span class="brand">☁️ CloudProfiles</span>
        <div><a href="/registro">Registrarse</a></div>
    </div>

    <div class="container auth-box">
        <div class="card">
            <h1>Iniciar sesion</h1>
            <% if (mensaje) { %>
                <div class="alerta alerta-<%= mensaje.tipo %>"><%= mensaje.texto %></div>
            <% } %>
            <form method="POST" action="/login">
                <div class="form-group">
                    <label>Correo electronico</label>
                    <input type="email" name="email" required>
                </div>
                <div class="form-group">
                    <label>Contraseña</label>
                    <input type="password" name="password" required>
                </div>
                <button type="submit" class="btn">Ingresar</button>
            </form>
            <p class="mt-16">¿No tienes cuenta? <a href="/registro">Registrate aqui</a></p>
        </div>
    </div>
</body>
</html>
